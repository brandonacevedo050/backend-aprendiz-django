# Este .env es para cuando corres Django directo (sin Docker) en tu maquina.
# Como MySQL queda expuesto en el puerto 3306 del host via docker-compose,
# localhost:3306 funciona igual lo hayas levantado con Docker o no.
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aprendiz
DB_USER=root
DB_PASSWORD=root
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173
